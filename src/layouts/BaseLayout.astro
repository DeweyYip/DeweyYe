---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const {
  title = 'Dewey Ye — Thoughts, Projects & Research',
  description = 'Personal space of Dewey Ye: ideas, projects, research interests and writing.'
} = Astro.props;
const root = import.meta.env.BASE_URL;
const items = [
  { name: 'Home', url: root },
  { name: 'About', url: root + 'about/' },
  { name: 'Research', url: root + 'research/' },
  { name: 'Projects', url: root + 'projects/' },
  { name: 'Writing', url: root + 'writing/' }
];
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f2" />
    <link rel="icon" type="image/svg+xml" href={root + 'favicon.svg'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-frame">
      <header class="site-header shell">
        <a class="wordmark" href={root} aria-label="Dewey Ye home">dewey<span>ye</span><i>.</i></a>
        <nav class="site-nav" aria-label="Main navigation">
          {items.map((item) => <a href={item.url} class:list={['nav-link', { current: item.url === pathname || (item.url !== root && pathname.startsWith(item.url)) }]}>{item.name}</a>)}
        </nav>
        <a class="nav-github" href="https://github.com/DeweyYip" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </header>
      <main class="shell"><slot /></main>
      <footer class="footer shell">
        <div><strong>DEWEY YE</strong><p>Building, thinking and learning in public.</p></div>
        <div class="footer-links">
          <a href={root + 'writing/'}>Writing</a>
          <a href="https://github.com/DeweyYip" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={root}>Back to top ↑</a>
        </div>
        <p class="copyright">© {new Date().getFullYear()} Dewey Ye · Made with curiosity.</p>
      </footer>
    </div>
  </body>
</html>
