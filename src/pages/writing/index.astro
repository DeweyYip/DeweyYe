---
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
const sorted = posts.sort((a, b) => String(b.frontmatter.pubDate).localeCompare(String(a.frontmatter.pubDate)));
---
<BaseLayout title="Writing — Dewey Ye" description="Notes, ideas, and essays from Dewey Ye.">
  <section class="page-heading"><p class="section-kicker">IDEAS IN PROGRESS</p><h1>The open<br /><em>notebook.</em></h1><p class="page-lead">Observations, questions, technical notes and whatever doesn't quite fit anywhere else.</p></section>
  <section class="section writing-list">
    {sorted.map((post) => <a class="writing-row" href={post.url}><span class="writing-date">{post.frontmatter.pubDate}</span><div><h2>{post.frontmatter.title}</h2><p>{post.frontmatter.description}</p></div><span class="writing-arrow">↗</span></a>)}
  </section>
  <p class="writing-hint">New notes can be added as Markdown files in <code>src/pages/writing/</code>.</p>
</BaseLayout>
