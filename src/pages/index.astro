---
import BaseLayout from '../layouts/BaseLayout.astro';
const root = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow"><span class="signal"></span> PERSONAL SPACE / EST. 2026</p>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-intro">Hi, I'm</p>
        <h1>Dewey<span class="line-two">Ye<span class="accent">.</span></span></h1>
        <p class="hero-lede">I explore the space between <em>intelligence</em>, technology, and human curiosity.</p>
        <p class="hero-small">Computer Science graduate · Interested in foundation models, multimodal reasoning, and building things that matter.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={root + 'about/'}>A little about me ↗</a>
          <a class="text-link" href={root + 'projects/'}>Explore my work ↗</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="art-topline"><span>FIG. 01</span><span>THOUGHTS IN PROGRESS</span></div>
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
        <div class="art-core"><span>DY</span><i></i></div>
        <span class="art-number">01 / ∞</span><span class="art-label">ALWAYS<br />BECOMING</span>
      </div>
    </div>
    <div class="hero-bottom"><span>SCROLL TO EXPLORE ↓</span><span>THINK / MAKE / QUESTION / REPEAT</span></div>
  </section>
  <section class="section two-col">
    <div><p class="section-kicker">01 — THE BIG PICTURE</p><h2>Not just what exists.<br /><em>What comes next.</em></h2></div>
    <div class="section-right">
      <p>I'm interested in how intelligent systems see, reason and interact with the world — and what it takes to make them more reliable.</p>
      <p>This website is a living collection of research interests, projects, ideas and occasional detours.</p>
      <a class="underlined" href={root + 'research/'}>Read about my interests ↗</a>
    </div>
  </section>
  <section class="section">
    <div class="section-header"><div><p class="section-kicker">02 — SELECTED WORK</p><h2>Things I'm building<span class="accent">.</span></h2></div><a class="text-link" href={root + 'projects/'}>All projects ↗</a></div>
    <a class="featured-project" href="https://github.com/DeweyYip/facial-visual-profile-hci" target="_blank" rel="noopener noreferrer">
      <div class="project-image"><div class="grid-pattern"></div><div class="profile-outline"><div class="profile-head"></div><div class="profile-shoulders"></div><i class="point p1"></i><i class="point p2"></i><i class="point p3"></i><i class="point p4"></i><i class="point p5"></i></div><div class="image-caption">VISUAL FEATURES / ROBUSTNESS / DEEP LEARNING</div></div>
      <div class="project-description"><p class="section-kicker">FEATURED PROJECT · COMPUTER VISION</p><h3>Facial Visual Profile <span>↗</span></h3><p>Exploring deep visual features, facial landmarks and robustness under image variations.</p><div class="tags"><span>PyTorch</span><span>ResNet</span><span>Visual Analysis</span></div></div>
    </a>
  </section>
  <section class="section ending-section">
    <div><p class="section-kicker">03 — NOTES & THOUGHTS</p><h2>An open notebook for<br /><em>unfinished ideas.</em></h2></div>
    <div><p>Some thoughts are better written down. A place for questions, experiments, lessons and everything in between.</p><a class="button button-light" href={root + 'writing/'}>Visit the notebook ↗</a></div>
  </section>
</BaseLayout>
